{
  "name": "hello-cf-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create hello-cf-db",
    "db:init:local": "wrangler d1 execute hello-cf-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute hello-cf-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
  }
}
