{
  "name": "mycare-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev -- npm run dev",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:create": "wrangler d1 create mycarePrototypeRDBMS",
    "db:schema:local": "wrangler d1 execute mycarePrototypeRDBMS --local --file=./db/schema.sql",
    "db:schema:remote": "wrangler d1 execute mycarePrototypeRDBMS --remote --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute mycarePrototypeRDBMS --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute mycarePrototypeRDBMS --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.131.2"
  }
}
